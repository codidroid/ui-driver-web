{
  "name": "ui-driver-web",
  "version": "0.1.0",
  "private": true,
  "description": "JSONL-case-driven Playwright runner for any web project. Standalone — drop alongside your repo and point E2E_BACKEND_BIN at your built server.",
  "scripts": {
    "build": "tsc -b",
    "server": "tsx src/bin.ts",
    "runner": "tsx test/runner.ts",
    "runner:all": "node test/run-all.js",
    "runner:smoke": "node test/run-all.js --case smoke_text_only --browser chromium",
    "runner:chromium": "node test/run-all.js --browser chromium",
    "runner:real": "node test/run-all.js --cases-dir cases-realcc --cc-mode real --browser chromium",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "express": "^4.19.0",
    "playwright": "^1.45.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "vitest": "^1.6.0"
  }
}
